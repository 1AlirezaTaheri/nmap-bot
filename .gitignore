# secrets - never commit (covers .env, .env.local, .env.bak-*, .env.*)
.env
.env.*
!.env.example

# secrets - never commit

# python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/

# test artifacts
.pytest_cache/

# virtualenvs
.venv/
venv/

# local backups
bot.py.bak
legacy/

# editor artifacts (nano/vim swap files can hold buffer contents)
*.swp
*.swo
.*.sw[a-p]

# frontend build artefacts (the admin image runs its own npm build)
node_modules/
admin/frontend/dist/
*.tsbuildinfo
npm-debug.log*

# local environment overrides
.env.local

# Mini App build artefacts (the image builds its own)
mini-app/dist/
mini-app/node_modules/
