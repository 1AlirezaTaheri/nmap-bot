# NetSentinel — environment template
# Copy to .env, fill in real values, then `chmod 600 .env`.

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# REQUIRED. Comma-separated numeric Telegram user IDs who may use the bot.
# The bot refuses to start if this is empty (fail closed, not open).
# Get your own ID from @userinfobot.
ALLOWED_USER_IDS=

# Optional. Comma-separated CIDRs a scan may target. When set, targets
# outside these ranges are rejected. Example: 192.168.0.0/16,10.0.0.0/8
ALLOWED_CIDRS=

# Database (PostgreSQL, provided by docker-compose.yml).
DATABASE_URL=postgresql+psycopg://netsentinel:netsentinel@db:5432/netsentinel

# Scan behaviour.
NMAP_BINARY=nmap
SCAN_TIMEOUT_SECONDS=300
MAX_CONCURRENT_SCANS=2
DEFAULT_PROFILE=service
