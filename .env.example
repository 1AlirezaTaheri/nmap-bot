# NetSentinel — environment template
# Copy to .env, fill in real values, then `chmod 600 .env`.

# --- required -----------------------------------------------------------
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs who may use the bot.
# The bot refuses to start if this is empty (fail closed, not open).
# Get your own ID from @userinfobot.
ALLOWED_USER_IDS=

# --- security -----------------------------------------------------------
# Comma-separated CIDRs a scan may target. When set, targets outside these
# ranges are rejected. Hostnames are refused in this mode (fail closed).
# Leave empty to allow any syntactically valid target.
ALLOWED_CIDRS=

# --- database -----------------------------------------------------------
# Placeholder credentials for the bundled dev database. Change them for
# anything you care about; docker-compose.yml overrides this with the same
# value, so the compose stack works without editing this file.
DATABASE_URL=postgresql+psycopg://netsentinel:netsentinel@db:5432/netsentinel

# --- scanning -----------------------------------------------------------
NMAP_BINARY=nmap
SCAN_TIMEOUT_SECONDS=60
MAX_CONCURRENT_SCANS=2
DEFAULT_PROFILE=service

# Minimum seconds between two scans of the same target.
RATE_LIMIT_SECONDS=30

# --- scheduled monitoring (V1) ------------------------------------------
# Turn recurring scans on. Off by default so a fresh install does not
# start scanning anything on its own.
SCHEDULE_ENABLED=false
SCHEDULE_INTERVAL_HOURS=6
SCHEDULE_PROFILE=service

# --- retention policy (V1) ----------------------------------------------
# Scans older than RETENTION_DAYS are deleted, except the newest successful
# scan per target (the change-detection baseline), which is always kept.
RETENTION_DAYS=30
RETENTION_MAX_SCANS_PER_TARGET=100

# --- export / report ----------------------------------------------------
# How many recent scans /export includes by default.
EXPORT_MAX_SCANS=20

# --- admin panel (V2) ---------------------------------------------------
# The panel refuses to start without a username and password, and will
# not fall back to a default: a panel reachable with a predictable
# credential is worse than one that refuses to boot. These create the
# FIRST superadmin, and only while admin_users is empty; afterwards the
# account is managed in the panel.
ADMIN_USERNAME=admin

# At least 12 characters; a weak value is rejected outright.
ADMIN_PASSWORD=

# Signs the session JWT. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# At least 32 characters. Rotating it invalidates every live session.
ADMIN_JWT_SECRET=

# Port the panel listens on inside the container. Compose publishes it on
# 127.0.0.1 only, because the panel serves plain HTTP with no TLS.
ADMIN_PORT=8080

# Set true once the panel sits behind an HTTPS proxy. Until then the
# session cookie travels over plain HTTP.
ADMIN_COOKIE_SECURE=false

# Trust the X-Forwarded-For header when deriving the client IP. Leave
# false unless a proxy you control sets that header: with it true and no
# proxy in front, any client can spoof its address and slip past the
# login rate limit.
ADMIN_TRUST_FORWARDED_FOR=false

# Address the panel binds inside the container. docker-compose.yml sets
# this to 0.0.0.0; do not set it lower there, or the published port
# will not reach the app.
ADMIN_HOST=0.0.0.0

# --- Telegram Mini App (V3) -----------------------------------------
# Public HTTPS origin the Mini App is served from. Telegram refuses to
# load a Mini App over plain HTTP, so leaving this empty disables the
# menu button, the /app command and the button in /start.
#
# With the bundled Cloudflare quick tunnel:
#   docker compose logs tunnel | grep -o 'https://[-a-z0-9]*.trycloudflare.com'
# then paste that URL here (no trailing slash) and restart the bot:
#   docker compose up -d --force-recreate bot admin
MINIAPP_URL=

# Reject initData older than this many seconds. Telegram's guidance is
# 86400 (one day).
MINIAPP_MAX_AGE_SECONDS=86400

# nmap processes the Mini App's worker may run at once. The bot has its
# own worker, so this is additional to MAX_CONCURRENT_SCANS.
MINIAPP_WORKER_CONCURRENCY=1
