# Secrets and local state must never enter an image layer.
.env
.env.*
!.env.example

# VCS / CI
.git
.github

# Python cache
__pycache__/
*.py[cod]
*.egg-info/

# Test artifacts
.pytest_cache/
tests/
pytest.ini

# Not needed at runtime
bot.py.bak
legacy/
make_graphical_abstract.py
graphical_abstract.png
logs/
*.log
*.md

# Frontend build artefacts (the image builds its own)
node_modules
**/node_modules
admin/frontend/dist
*.tsbuildinfo
npm-debug.log
